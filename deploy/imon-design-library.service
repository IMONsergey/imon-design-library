[Unit]
Description=Validate and publish I’MON Design Library
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=imon-design-library
Group=imon-design-library
WorkingDirectory=/srv/imon-design-library
Environment=GIT_TERMINAL_PROMPT=0
Environment=GIT_CONFIG_GLOBAL=/dev/null
Environment=GIT_CONFIG_NOSYSTEM=1
Environment=NODE_ENV=production
ExecStart=/usr/bin/flock -n /srv/imon-design-library/deploy.lock /opt/imon-runtime/node/bin/node /usr/local/lib/imon-design-library/update.mjs
TimeoutStartSec=600
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/imon-design-library
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
CPUQuota=75%

[Install]
WantedBy=multi-user.target
