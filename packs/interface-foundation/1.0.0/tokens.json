{
  "namespace": "imon-foundation",
  "description": "Original I’MON starter tokens. See LICENSE.txt before reuse.",
  "color": {
    "background": { "$type": "color", "$value": "#f5f4f0" },
    "surface": { "$type": "color", "$value": "#ffffff" },
    "text": { "$type": "color", "$value": "#20211e" },
    "muted": { "$type": "color", "$value": "#62665e" },
    "line": { "$type": "color", "$value": "#d4d7ce" },
    "accent": { "$type": "color", "$value": "#365640" },
    "accent-hover": { "$type": "color", "$value": "#284431" },
    "focus": { "$type": "color", "$value": "#2354a3" },
    "error": { "$type": "color", "$value": "#a12930" }
  },
  "space": {
    "1": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "2": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } },
    "3": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
    "4": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
    "6": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
    "8": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
    "12": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
  },
  "radius": {
    "small": { "$type": "dimension", "$value": { "value": 4, "unit": "px" } },
    "medium": { "$type": "dimension", "$value": { "value": 8, "unit": "px" } }
  },
  "control": {
    "height": { "$type": "dimension", "$value": { "value": 44, "unit": "px" } }
  }
}
